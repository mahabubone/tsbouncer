{
  "name": "@tsbouncer/kysely",
  "version": "1.0.0-dev.0",
  "description": "TupleStore over an application-owned Kysely instance.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "authorization",
    "authz",
    "store",
    "kysely",
    "sql",
    "esm"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "kysely": ">=0.27"
  },
  "dependencies": {
    "@tsbouncer/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "kysely": "0.29.6",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "@tsbouncer/testkit": "workspace:*",
    "@vitest/coverage-v8": "5.0.2",
    "better-sqlite3": "13.0.3",
    "@types/better-sqlite3": "7.6.13"
  }
}
