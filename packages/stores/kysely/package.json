{
  "name": "@tsbouncer/kysely",
  "version": "1.0.0-preview.1",
  "description": "TupleStore over an application-owned Kysely instance.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahabubone/tsbouncer.git",
    "directory": "packages/stores/kysely"
  },
  "bugs": {
    "url": "https://github.com/mahabubone/tsbouncer/issues"
  },
  "homepage": "https://github.com/mahabubone/tsbouncer/tree/main/packages/stores/kysely#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "authorization",
    "authz",
    "store",
    "kysely",
    "sql",
    "esm"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "kysely": ">=0.29.0 <0.30"
  },
  "dependencies": {
    "@tsbouncer/tsbouncer": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@tsbouncer/testkit": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.2",
    "better-sqlite3": "13.0.3",
    "kysely": "0.29.6",
    "pg": "^8.23.0",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
