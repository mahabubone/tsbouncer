{
  "name": "@tsbouncer/memory",
  "version": "0.0.0",
  "description": "Process-local TupleStore. Ideal for isolated tests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "authorization",
    "authz",
    "store",
    "memory",
    "esm"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "publint --strict && attw --pack . --profile esm-only",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tsbouncer/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "@tsbouncer/testkit": "workspace:*",
    "@vitest/coverage-v8": "5.0.2"
  }
}
