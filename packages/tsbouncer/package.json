{
  "name": "tsbouncer",
  "version": "1.0.0-dev.0",
  "description": "The bouncer for TypeScript/JS ESM-only apps. Authorization graph SDK with pluggable storage.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "authorization",
    "authz",
    "rebac",
    "rbac",
    "abac",
    "zanzibar",
    "permissions",
    "esm"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@tsbouncer/core": "workspace:*",
    "@tsbouncer/json": "workspace:*",
    "@tsbouncer/memory": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@vitest/coverage-v8": "5.0.2",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "@types/node": "26.6.3"
  }
}
