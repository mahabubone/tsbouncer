{
  "name": "tsbouncer",
  "version": "1.0.0-preview.1",
  "description": "Authorization graph SDK for TypeScript ESM apps. Kernel and ports at the root; stores and caches are separate adapter packages.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahabubone/tsbouncer.git",
    "directory": "packages/tsbouncer"
  },
  "bugs": {
    "url": "https://github.com/mahabubone/tsbouncer/issues"
  },
  "homepage": "https://github.com/mahabubone/tsbouncer/tree/main/packages/tsbouncer#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "authorization",
    "authz",
    "rebac",
    "rbac",
    "abac",
    "zanzibar",
    "permissions",
    "esm"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@tsbouncer/testkit": "workspace:*",
    "@vitest/coverage-v8": "5.0.2",
    "@types/node": "26.6.3",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
