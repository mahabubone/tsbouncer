{
  "name": "tsbouncer-workspace",
  "version": "1.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "The bouncer for TypeScript/JS ESM-only apps.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build --filter=!tsbouncer-docs",
    "typecheck": "turbo run typecheck --filter=!tsbouncer-docs",
    "test": "turbo run test --filter=!tsbouncer-docs",
    "test:watch": "vitest --root packages/core",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "pack:check": "turbo run pack:check --filter=!tsbouncer-docs",
    "check": "pnpm lint && pnpm versions && pnpm typecheck && pnpm build && pnpm pack:check && pnpm test:coverage && pnpm examples",
    "test:coverage": "turbo run test:coverage --filter=!tsbouncer-docs",
    "coverage": "turbo run test:coverage",
    "examples": "turbo run start",
    "versions": "node scripts/check-versions.mjs",
    "docs:dev": "pnpm --filter tsbouncer-docs dev",
    "docs:build": "pnpm --filter tsbouncer-docs build",
    "docs:test": "pnpm --filter tsbouncer-docs test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.11.5",
    "typescript": "5.9.3",
    "@vitest/coverage-v8": "5.0.2",
    "vitest": "5.0.2",
    "tsx": "4.23.15"
  }
}
