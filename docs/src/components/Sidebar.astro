---
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  current: string | undefined;
}

const { current } = Astro.props;

const entries = (await getCollection('docs')).filter((e) => !e.data.hidden);
entries.sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

/** Group by `section`, preserving the order sections first appear in. */
const sections: { name: string; pages: CollectionEntry<'docs'>[] }[] = [];
for (const entry of entries) {
  const name = entry.data.section ?? '';
  let group = sections.find((s) => s.name === name);
  if (!group) {
    group = { name, pages: [] };
    sections.push(group);
  }
  group.pages.push(entry);
}

const href = (id: string) => `/${id}`;
const isActive = (id: string) => current === id;

const KIND_LABEL: Record<string, string> = {
  recipe: 'recipe',
  reference: 'API',
};
---

<nav aria-label="Documentation" class="flex flex-col gap-6 py-6">
  {
    sections.map((section) => (
      <div>
        {section.name !== '' && (
          <p class="px-3 pb-2 text-xs font-semibold tracking-wider text-[var(--text-subtle)] uppercase">
            {section.name}
          </p>
        )}
        <ul class="flex flex-col gap-0.5">
          {section.pages.map((entry) => {
            const active = isActive(entry.id);
            const badge = KIND_LABEL[entry.data.kind];
            return (
              <li>
                <a
                  href={href(entry.id)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm transition-colors',
                    active
                      ? 'bg-[var(--accent)]/10 font-semibold text-[var(--accent)]'
                      : 'text-[var(--text-muted)] hover:bg-[var(--surface-sunken)] hover:text-[var(--text)]',
                  ]}
                >
                  <span class="truncate">{entry.data.title}</span>
                  {badge && (
                    <span
                      class:list={[
                        'ml-auto shrink-0 rounded px-1.5 py-0.5 text-[0.6875rem] font-medium',
                        entry.data.kind === 'reference'
                          ? 'bg-[var(--surface-sunken)] text-[var(--text-subtle)]'
                          : 'bg-[var(--accent)]/12 text-[var(--accent)]',
                      ]}
                    >
                      {badge}
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
