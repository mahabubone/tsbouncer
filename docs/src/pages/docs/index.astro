---
import { getEntry, render } from 'astro:content';
import DocsLayout from '~/layouts/DocsLayout.astro';

/**
 * The docs home. The `index` entry is excluded from the `/docs/*` route so it
 * has exactly one canonical URL.
 */
const entry = await getEntry('docs', 'index');
if (!entry) throw new Error('docs/index is missing — the docs home has no content');

const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  current="index"
  kind={entry.data.kind}
  status={entry.data.status}
>
  <Content />
</DocsLayout>
