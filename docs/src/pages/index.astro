---
import '~/styles/global.css';

/**
 * The marketing landing. It is a bespoke page rather than a collection entry,
 * so it stays out of the sidebar, the snippet checker, and search — those are
 * the docs' machinery, and the landing is not docs.
 *
 * The tour output below is real: it is the assertion script of the Hono guide,
 * run against a live server, abridged to fit. If the app stops behaving this
 * way, the guide fails — so this page cannot drift from it quietly.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '');
const docs = (path = '') => `${base}/docs${path === '' ? '' : `/${path}`}`;

const features = [
  {
    title: 'In-process, not over the wire',
    body: 'The evaluator runs inside your request handler against storage you already own. No sidecar, no extra hop, no new failure domain.',
  },
  {
    title: 'Every decision explains itself',
    body: 'explain() returns the tree that produced the answer — which edges held, which missed, how many reads it took. Support stops guessing.',
  },
  {
    title: 'Fail closed, everywhere',
    body: 'Unknown condition, missing key, thrown predicate, exhausted budget: all deny. There is no permissive fallback anywhere.',
  },
  {
    title: 'Budgets, not hope',
    body: 'Depth, node, and deadline ceilings per request. Exhaustion denies and reports truncated, so a partial answer never looks complete.',
  },
  {
    title: 'Lists that refuse to invent',
    body: 'A wildcard grant reports a symbolic set, not a fabricated roster. listResources always says whether its answer is whole.',
  },
  {
    title: 'Conditions as code',
    body: 'Predicates are TypeScript functions beside your domain logic. Tuple bindings win; the request only fills the gaps.',
  },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tsbouncer · authorization your app can explain</title>
    <meta
      name="description"
      content="One model, one set of tuples, one evaluator — over storage your application already has."
    />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%233b6ef5'/%3E%3Cpath d='M9 22V10h5.2c2.6 0 4.2 1.3 4.2 3.4 0 1.5-.8 2.5-2.1 2.9l2.6 5.7h-2.9l-2.3-5.3h-2.3V22H9zm2.4-7.2h2.6c1.1 0 1.8-.5 1.8-1.4s-.7-1.4-1.8-1.4h-2.6v2.8z' fill='white'/%3E%3Ccircle cx='23' cy='19' r='2.5' fill='white'/%3E%3C/svg%3E"
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('tsbouncer-theme');
        const dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>

  <body class="min-h-screen">
    <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-5 sm:px-8">
      <header class="flex items-center gap-2 py-6 font-semibold tracking-tight">
        <span
          class="grid h-6 w-6 place-items-center rounded-md bg-[var(--accent)] text-[0.8125rem] font-bold text-[var(--accent-contrast)]"
          aria-hidden="true"
          >t</span
        >
        <span>tsbouncer</span>
        <span
          class="rounded-full border border-[var(--border)] px-2 py-0.5 font-mono text-[0.6875rem] text-[var(--text-subtle)]"
          >1.0.0-preview.1</span
        >
        <nav class="ml-auto flex items-center gap-1 text-sm">
          <a
            href={docs()}
            class="rounded-lg px-3 py-1.5 text-[var(--text-muted)] transition-colors hover:bg-[var(--surface-sunken)] hover:text-[var(--text)]"
            >Docs</a
          >
          <a
            href={docs('reference/comparison')}
            class="hidden rounded-lg px-3 py-1.5 text-[var(--text-muted)] transition-colors hover:bg-[var(--surface-sunken)] hover:text-[var(--text)] sm:block"
            >Comparison</a
          >
          <a
            href="https://github.com/tsbouncer/tsbouncer"
            rel="noreferrer noopener"
            class="rounded-lg px-3 py-1.5 text-[var(--text-muted)] transition-colors hover:bg-[var(--surface-sunken)] hover:text-[var(--text)]"
            >GitHub</a
          >
        </nav>
      </header>

      <main class="flex flex-1 flex-col">
        <section class="py-14 sm:py-20">
          <p
            class="mb-4 inline-block rounded-full border border-[var(--border)] px-3 py-1 font-mono text-xs text-[var(--text-subtle)]"
          >
            TypeScript-native authorization · MIT · ESM only
          </p>
          <h1
            class="mb-5 max-w-2xl text-5xl font-bold tracking-tight text-balance sm:text-6xl"
            style="letter-spacing: -0.02em"
          >
            Authorization your app can explain.
          </h1>
          <p class="mb-8 max-w-xl text-lg text-[var(--text-muted)] text-pretty">
            One model, one set of tuples, one evaluator — over storage your
            application already has. No server, no port, no network hop.
          </p>

          <div class="mb-10 flex flex-wrap items-center gap-3">
            <a
              href={docs('getting-started')}
              class="rounded-lg bg-[var(--accent)] px-5 py-2.5 text-sm font-semibold text-[var(--accent-contrast)]"
              >Get started</a
            >
            <a
              href={docs('guides/hono-rbac')}
              class="rounded-lg border border-[var(--border)] px-5 py-2.5 text-sm font-medium text-[var(--text)]"
              >Build the sample API</a
            >
          </div>

          <div
            class="overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--surface-sunken)]"
          >
            <div class="flex items-center gap-1.5 border-b border-[var(--border)] px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[var(--border-strong)]" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[var(--border-strong)]" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[var(--border-strong)]" aria-hidden="true"></span>
              <span class="ml-2 font-mono text-xs text-[var(--text-subtle)]"
                >npx tsx src/verify.ts — the Hono guide's assertion script, abridged</span
              >
            </div>
            <pre class="overflow-x-auto p-4 font-mono text-[0.8125rem] leading-relaxed"><code><span class="text-[var(--text-subtle)]">$ npm i tsbouncer</span>
<span class="text-[var(--color-flag-pass)]">ok</span>   a known user reads what they own                     200
<span class="text-[var(--color-flag-pass)]">ok</span>   a role grants access to every document it is attached to 200
<span class="text-[var(--color-flag-pass)]">ok</span>   a viewer may read but not write                      403
<span class="text-[var(--color-flag-pass)]">ok</span>   an editor may not change who has access              403
<span class="text-[var(--color-flag-pass)]">ok</span>   a grant whose row was hard-deleted is a 404          404
<span class="text-[var(--color-flag-pass)]">ok</span>   why returns the decision tree, not a guess           200

  19 of 19 scenarios passed</code></pre>
          </div>
        </section>

        <section class="border-t border-[var(--border)] py-14">
          <h2 class="mb-2 text-2xl font-bold tracking-tight">Declare it. Ask it. Get a reason.</h2>
          <p class="mb-8 max-w-xl text-[var(--text-muted)]">
            The whole library is three calls. The model is code, the grants are
            data, and the answer cites its sources.
          </p>
          <div class="grid gap-4 md:grid-cols-2">
            <div
              class="overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--surface-sunken)]"
            >
              <p class="border-b border-[var(--border)] px-4 py-2 font-mono text-xs text-[var(--text-subtle)]">
                src/model.ts
              </p>
              <pre class="overflow-x-auto p-4 font-mono text-[0.8125rem] leading-relaxed"><code>defineType('document', &#123;
  relations: &#123;
    owner: relation('user'),
    editor: relation('user')
      .or(relation('role', &#123; through: 'holder' &#125;)),
  &#125;,
  permissions: &#123;
    read: permission.or('owner', 'editor'),
    write: permission.or('owner', 'editor'),
    manage: permission.or('owner'),
  &#125;,
&#125;)</code></pre>
            </div>
            <div
              class="overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--surface-sunken)]"
            >
              <p class="border-b border-[var(--border)] px-4 py-2 font-mono text-xs text-[var(--text-subtle)]">
                src/verify.ts
              </p>
              <pre class="overflow-x-auto p-4 font-mono text-[0.8125rem] leading-relaxed"><code><span class="text-[var(--text-subtle)]">// Bob holds the editor role. Carol only views.</span>
await authz.can('user:bob', 'document.read', 'document:1')
<span class="text-[var(--color-flag-pass)]">// → true — editor, through role:acme:editor#holder</span>

await authz.can('user:carol', 'document.write', 'document:1')
<span class="text-[var(--color-flag-fail)]">// → false — a viewer may read but not write</span>

await authz.explain(&#123; subject: 'user:carol',
  permission: 'document.write', resource: 'document:1' &#125;)
<span class="text-[var(--text-subtle)]">// → the tree: which edges held, which missed,
//    and how many store reads it took</span></code></pre>
            </div>
          </div>
        </section>

        <section class="border-t border-[var(--border)] py-14">
          <h2 class="mb-2 text-2xl font-bold tracking-tight">Why teams pick it up</h2>
          <p class="mb-8 max-w-xl text-[var(--text-muted)]">
            Each of these is a checked guarantee, not a slogan — the contract
            report runs against a real store on every build.
          </p>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              features.map((feature) => (
                <div class="rounded-xl border border-[var(--border)] p-5">
                  <p class="mb-1 font-semibold">{feature.title}</p>
                  <p class="text-sm text-[var(--text-muted)]">{feature.body}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-8 text-sm text-[var(--text-muted)]">
            Coming from Google Zanzibar or OpenFGA? Read
            <a href={docs('reference/comparison')} class="text-[var(--accent)] underline"
              >the comparison catalog</a
            > — including the rows where this library is the worse answer.
          </p>
        </section>
      </main>

      <footer class="border-t border-[var(--border)] py-8 text-sm text-[var(--text-subtle)]">
        <p>
          tsbouncer <span class="font-mono">1.0.0-preview.1</span> · Apache-2.0 · ESM only ·
          Pre-1.0, the API is not settled. The
          <a href={docs('reference/guarantees')} class="text-[var(--accent)] underline"
            >guarantees page</a
          >
          is checked on every build.
        </p>
      </footer>
    </div>
  </body>
</html>
