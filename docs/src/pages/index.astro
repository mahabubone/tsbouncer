---
import { getEntry, render } from 'astro:content';
import DocsLayout from '~/layouts/DocsLayout.astro';

/**
 * The landing page is a collection entry rather than a bespoke page, so the intro
 * is in the sidebar, in the snippet checker, and in search like everything else.
 * It is excluded from the `/docs/*` route so it has exactly one canonical URL.
 */
const entry = await getEntry('docs', 'index');
if (!entry) throw new Error('docs/index is missing — the landing page has no content');

const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  current="index"
  kind={entry.data.kind}
  status={entry.data.status}
>
  <Content />
</DocsLayout>
