---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '~/layouts/DocsLayout.astro';

/**
 * Every MDX page renders through this one route, so the layout, the sidebar's
 * active state, and the snippet checker all agree on the same collection.
 *
 * `getStaticPaths` is required for static output, and it is also what proves the
 * collection loads: broken frontmatter fails the build here rather than on the
 * page a reader is trying to read.
 */
export async function getStaticPaths() {
  // `index` is the landing page and lives at `/`; rendering it here too would
  // give the same content two canonical URLs.
  const entries = (await getCollection('docs')).filter((e) => e.id !== 'index');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  current={entry.id}
  kind={entry.data.kind}
  status={entry.data.status}
>
  <Content />
</DocsLayout>
